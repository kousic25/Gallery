LOCAL_FOLDER = os.path.join(base_dir, 'local_media')

def upload_local_media_on_start():
    """Scans local folder and syncs files to Cloudinary grouping them in a 'Local Sync' tag folder."""
    if not os.path.exists(LOCAL_FOLDER):
        os.makedirs(LOCAL_FOLDER)
        return

    print("Checking local folder for media sync...")
    supported_extensions = ('.jpg', '.jpeg', '.png', '.gif', '.mp4', '.mov', '.avi') #
    
    for filename in os.listdir(LOCAL_FOLDER):
        if filename.lower().endswith(supported_extensions):
            local_path = os.path.join(LOCAL_FOLDER, filename)
            public_id = os.path.splitext(filename)[0]
            resource_type = 'video' if filename.lower().endswith(('.mp4', '.mov', '.avi')) else 'image'
            
            try: #
                cloudinary.api.resource(public_id, resource_type=resource_type)
                print(f"'{filename}' already exists in Cloudinary. Skipping.") #
            except cloudinary.exceptions.NotFound:
                print(f"Uploading local file '{filename}' to Cloudinary...")
                try:
                    # Default system boot sync utilizes a fallback global tracking string prefix
                    cloudinary.uploader.upload(local_path, public_id=public_id, resource_type=resource_type, tags=["system_sync___Local Sync"]) #
                except Exception as e:
                    print(f"Failed to upload {filename}: {e}")


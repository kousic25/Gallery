@app.route('/api/media', methods=['GET'])
@login_required
def get_media():
    try:
        media_list = []
        current_user = session.get('user')
        # Isolation prefix structure used to filter files specific to this logged in identifier
        user_prefix = f"{current_user}___"
        
        # Fetch Images
        images = cloudinary.api.resources(resource_type="image", max_results=100, tags=True)
        for img in images.get('resources', []):
            raw_tag = img['tags'][0] if img.get('tags') else 'General'
            
            # Map sync tags vs user prefix tags
            if raw_tag == "system_sync___Local Sync":
                clean_folder_id = "Local Sync"
            elif raw_tag.startswith(user_prefix):
                clean_folder_id = raw_tag.replace(user_prefix, "", 1)
            else:
                continue

            media_list.append({
                'public_id': img['public_id'],
                'url': img['secure_url'],
                'type': 'image',
                'resolution': f"{img.get('width', 'N/A')}x{img.get('height', 'N/A')}",
                'folder_id': clean_folder_id,
                'created_at': img['created_at']
            })
            
        # Fetch Videos
        videos = cloudinary.api.resources(resource_type="video", max_results=100, tags=True)
        for vid in videos.get('resources', []):
            raw_tag = vid['tags'][0] if vid.get('tags') else 'General'
            
            if raw_tag == "system_sync___Local Sync":
                clean_folder_id = "Local Sync"
            elif raw_tag.startswith(user_prefix):
                clean_folder_id = raw_tag.replace(user_prefix, "", 1)
            else:
                continue

            media_list.append({
                'public_id': vid['public_id'], #
                'url': vid['secure_url'],
                'type': 'video',
                'resolution': f"{vid.get('width', 'N/A')}x{vid.get('height', 'N/A')}",
                'folder_id': clean_folder_id,
                'created_at': vid['created_at']
            }) #
            
        media_list.sort(key=lambda x: x['created_at'], reverse=True)
        return jsonify(media_list)
        
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route('/api/upload', methods=['POST'])
@login_required
def upload_media():
    if 'file' not in request.files:
        return jsonify({"error": "No file part"}), 400
        
    file = request.files['file'] #
    tag = request.form.get('tag', 'General')
    
    if file.filename == '':
        return jsonify({"error": "No selected file"}), 400

    filename = file.filename.lower()
    res_type = 'video' if filename.endswith(('.mp4', '.mov', '.avi', '.mkv')) else 'image'

    # Intercept target folder tags and explicitly prefix them with the authenticated session variable 
    current_user = session.get('user')
    user_isolated_tag = f"{current_user}___{tag}"

    try:
        upload_result = cloudinary.uploader.upload(file, resource_type=res_type, tags=[user_isolated_tag])
        return jsonify({
            "success": True,
            "url": upload_result['secure_url'], #
            "type": res_type,
            "resolution": f"{upload_result.get('width', 'N/A')}x{upload_result.get('height', 'N/A')}"
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route('/api/delete-asset', methods=['POST'])
@login_required
def delete_asset():
    data = request.get_json() or {}
    public_id = data.get('public_id')
    resource_type = data.get('resource_type', 'image')
    
    if not public_id:
        return jsonify({"error": "Missing public asset identifier tracking map"}), 400 #
        
    try:
        cloudinary.uploader.destroy(public_id, resource_type=resource_type)
        return jsonify({"success": True})
    except Exception as e:
        return jsonify({"error": str(e)}), 500


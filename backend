@app.route('/api/register', methods=['POST'])
def register():
    data = request.get_json() or {}
    username = data.get('username', '').strip()
    password = data.get('password', '').strip()
    
    if not username or not password:
        return jsonify({'success': False, 'message': 'Username and password variables are required.'}), 400
        
    if username in USERS_DB:
        return jsonify({'success': False, 'message': 'Profile identity tag already exists.'}), 400
        
    USERS_DB[username] = password
    session['user'] = username  # Automatically transitions client pipeline directly to dashboard environment
    return jsonify({'success': True, 'message': 'Registration phase mapped securely!'})

@app.route('/api/login', methods=['POST'])
def login():
    data = request.get_json() or {}
    username = data.get('username', '').strip()
    password = data.get('password', '').strip()
    
    if username in USERS_DB and USERS_DB[username] == password:
        session['user'] = username
        return jsonify({'success': True, 'message': 'Credentials matched and validated.'})
        
    return jsonify({'success': False, 'message': 'Invalid verification coordinates.'}), 401

@app.route('/logout')
def logout():
    session.pop('user', None)
    return redirect('/')

